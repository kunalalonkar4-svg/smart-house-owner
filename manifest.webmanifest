{
  "name": "Smart House Owner",
  "short_name": "Smart House",
  "description": "Ghar banwane walon ke liye free inspection app: checklist, photo check, hisaab, reminders aur engineer salah.",
  "lang": "hi",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F5F4F0",
